{
  "lastChangelogVersion": "0.84.4",
  "theme": "tokyo-night-storm",
  "defaultProvider": "xai-auth",
  "defaultModel": "grok-4.6",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    "npm:@hypabolic/pi-hypa",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff",
    "npm:@firstpick/pi-themes-bundle",
    "npm:pi-xai-oauth",
{{- if hasKey . "pi_hunk_dev_path" }}
    {{ .pi_hunk_dev_path | quote }}
{{- else }}
    "npm:pi-hunk"
{{- end }}
  ]
}
