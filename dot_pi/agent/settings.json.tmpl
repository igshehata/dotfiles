{
  "lastChangelogVersion": "0.84.4",
  "theme": "tokyo-night-storm",
{{- if hasKey . "pi_default_provider" }}
  "defaultProvider": {{ .pi_default_provider | quote }},
{{- end }}
{{- if hasKey . "pi_default_model" }}
  "defaultModel": {{ .pi_default_model | quote }},
{{- end }}
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    "npm:@hypabolic/pi-hypa",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff",
    "npm:@firstpick/pi-themes-bundle",
    "npm:pi-xai-oauth",
{{- if hasKey . "pi_hunk_dev_path" }}
    {{ .pi_hunk_dev_path | quote }}
{{- else }}
    "npm:pi-hunk"
{{- end }}
  ]
}
