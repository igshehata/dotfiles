# Homebrew inventory for every machine (~/.Brewfile, managed by chezmoi).
# `chezmoi apply` installs anything missing (run_onchange_after_15-brew-bundle.sh).
#
#   add:     brew add <formula>          brew add --cask <app>    (macOS-only)
#   remove:  brew drop <formula>         brew drop --cask <app>
#   update:  brew upgrade <formula>
#   drift:   brew bundle cleanup --global   (lists installed but undeclared)
#
# `brew add`/`brew drop` (~/.local/bin/brew-{add,drop}) install or uninstall and
# edit the chezmoi source of this file; publish with `cz push`. New entries are
# appended at the end. Languages and runtimes (node, bun, python, go, ...) live
# in ~/.config/mise/config.toml, not here.

tap "can1357/tap"
tap "rjyo/moshi"

brew "agent-browser"
brew "aichat"
brew "atuin"
brew "bat"
