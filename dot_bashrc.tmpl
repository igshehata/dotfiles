if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

export PATH="/run/current-system/sw/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
# bun global packages (`bun add -g`); bun itself comes from mise
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

alias ls="eza -l --no-permissions --icons --git"
alias ll="eza -la --no-permissions --icons --git"
alias la="eza -a --icons --git"
alias lt="eza -T --no-permissions --icons --level=2 --git"
alias llt="eza -lT --no-permissions --icons --level=2 --git"
alias nv="nvim"
alias py="python3"
alias pip="pip3"
{{ if eq .chezmoi.os "darwin" -}}
alias drs='sudo darwin-rebuild switch --flake ~/nix-config#{{ .chezmoi.hostname }}'
{{ else -}}
alias sms='nix run --inputs-from ~/nix-config system-manager -- switch --flake ~/nix-config --sudo'
{{- end }}

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init bash)"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

if command -v carapace >/dev/null 2>&1; then
  source <(carapace _carapace bash)
fi

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init bash)"; fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi
