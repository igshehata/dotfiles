#!/usr/bin/env bash
# Syncs fish plugins to ~/.config/fish/fish_plugins (the manifest) whenever it
# changes, here or after a pull from another machine: installs fisher if
# missing, installs declared plugins, removes undeclared ones. Fisher has no
# lockfile, so this also moves plugins to their latest version. Add a plugin
# with `fisher install owner/repo`, then `cz capture ~/.config/fish/fish_plugins`.
# Never fails an apply: worst case it prints what to run.
#
# fish_plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

set -uo pipefail

if ! command -v fish >/dev/null 2>&1; then
    echo "chezmoi: fish not found - skipping fish plugins" >&2
    exit 0
fi

if ! fish -c 'type -q fisher; or curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; fisher update' >/dev/null 2>&1; then
    echo "chezmoi: fish plugin sync failed - rerun in fish: fisher update" >&2
fi

exit 0
