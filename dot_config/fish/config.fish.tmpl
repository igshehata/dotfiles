if status is-interactive
    # Enable vim mode
    fish_vi_key_bindings

    # Option+Backspace: delete word backward (works in vi insert mode)
    bind -M insert \e\x7f backward-kill-word
    # Command+Backspace: delete to start of line (works in vi insert mode)
    bind -M insert \cU backward-kill-line

    if command -q fnm
        fnm env --use-on-cd | source
    end

    if command -q mise
        mise activate fish | source
    end

    # Initialize starship prompt
    if command -q starship
        starship init fish | source
    end

    # Initialize atuin (history sync)
    if command -q atuin
        atuin init fish | source
    end

    # Configure transient prompt - shows only character module
    function starship_transient_prompt_func
        starship module character
    end

    # Configure right-side transient prompt - shows time module
    function starship_transient_rprompt_func
        starship module time
    end

    # Enable transient prompt mode
    if functions -q enable_transience
        enable_transience
    end

    # Initialize zoxide
    if command -q zoxide
        zoxide init fish | source
    end
    # Set up fzf key bindings (disabled - using television for ctrl+t instead)
    # fzf --fish | source
    # Initialize carapace completions
    if command -q carapace
        carapace _carapace | source
    end

    # Git push: Tab inserts "origin <current-branch>" directly (no escaped space)
    function _git_push_tab_complete
        set -l line (commandline --current-buffer)
        set -l cursor (commandline --cursor)
        set -l line_trim (string trim --right --chars ' ' -- $line)

        if test $cursor -eq (string length -- $line)
            if string match -qr '^(gp|git push)$' -- $line_trim
                set -l branch (command git branch --show-current 2>/dev/null)
                if test -n "$branch"
                    if test "$line_trim" = "gp"
                        commandline --replace "gp origin $branch"
                    else
                        commandline --replace "git push origin $branch"
                    end
                    commandline --cursor (string length -- (commandline --current-buffer))
                    return
                end
            end
        end

        commandline -f complete
    end

    bind -M insert \t _git_push_tab_complete
    bind -M default \t _git_push_tab_complete

    alias ci code-insiders
    alias nv nvim
    alias ?? aichat
    alias ls 'eza -l --no-permissions --icons --git'
    alias ll 'eza -la --no-permissions --icons --git'
    alias la 'eza -a --icons --git'
    alias lt 'eza -T --no-permissions --icons --level=2 --git --git-ignore'
    alias llt 'eza -lT --no-permissions --icons --level=2 --git --git-ignore'

    # Python aliases
    alias py=python3
    alias pip=pip3

    # Nix darwin (requires sudo since May 2025 - Phase 1 of multi-user support)
    abbr --add drs 'sudo darwin-rebuild switch --flake ~/nix-config#{{ .chezmoi.hostname }}'
end

# nix add/dedupe - Nix configuration helpers
function nix
    if test (count $argv) -lt 1
        echo "Usage: nix <add|dedupe> [--brew|--cask|--nix] [packages...]"
        return 1
    end

    set subcommand $argv[1]
    set packages $argv[2..-1]
    set config_file (command chezmoi source-path ~/nix-config/configuration.nix)

    switch $subcommand
        case add
            # Parse flags
            set target brew
            set pkg_list

            for arg in $packages
                switch $arg
                    case --brew
                        set target brew
                    case --cask
                        set target cask
                    case --nix
                        set target nix
                    case '*'
                        set -a pkg_list $arg
                end
            end

            if test (count $pkg_list) -lt 1
                echo "Usage: nix add [--brew|--cask|--nix] <package1> [package2] ..."
                echo "  (default)  Add to Homebrew brews"
                echo "  --brew     Add to Homebrew brews"
                echo "  --cask     Add to Homebrew casks"
                echo "  --nix      Add to nix packages"
                return 1
            end

            for pkg in $pkg_list
                switch $target
                    case nix
                        sed -i '' "/environment.systemPackages = with pkgs; \[/a\\
    $pkg" $config_file
                        echo "Added $pkg to nix packages"
                    case brew
                        sed -i '' "/brews = \[/a\\
      \"$pkg\"" $config_file
                        echo "Added $pkg to brews"
                    case cask
                        sed -i '' "/casks = \[/a\\
      \"$pkg\"" $config_file
                        echo "Added $pkg to casks"
                end
            end

            echo ""
            switch $target
                case brew
                    echo "Inventory updated in chezmoi source."
                    echo "To use it now, run: brew install "(string join ' ' $pkg_list)
                case cask
                    echo "Inventory updated in chezmoi source."
                    echo "To use it now, run: brew install --cask "(string join ' ' $pkg_list)
                case nix
                    echo "Inventory updated in chezmoi source."
                    echo "Run chezmoi apply when you want ~/nix-config/configuration.nix rendered, then drs when you want full machine reconcile."
            end

        case dedupe
            # Extract nix packages (between systemPackages = [ and ];)
            set nix_pkgs (sed -n '/environment.systemPackages/,/\];/p' $config_file | grep -oE '^\s+\w+' | tr -d ' ')

            # Extract brews (between brews = [ and ];)
            set brews (sed -n '/brews = \[/,/\];/p' $config_file | grep -oE '"[^"]+"' | tr -d '"')

            set found 0
            for pkg in $nix_pkgs
                if contains $pkg $brews
                    sed -i '' "/brews = \[/,/\];/{ /\"$pkg\"/d; }" $config_file
                    echo "Removed '$pkg' from brews (exists in nix packages)"
                    set found (math $found + 1)
                end
            end

            if test $found -eq 0
                echo "No duplicates found"
            else
                echo ""
                echo "Removed $found duplicate(s)"
                echo "Inventory updated in chezmoi source."
                echo "Run chezmoi apply when you want ~/nix-config/configuration.nix rendered."
            end

        case '*'
            # Pass through to actual nix command
            command nix $argv
    end
end

# chezmoi workflow helpers
function __cz_push --description "Commit and push dotfiles source changes"
    set -l dirty (chezmoi git -- status --porcelain 2>/dev/null)
    # A clean tree does not mean nothing to send: commits can already exist
    # locally and never have been pushed. Check the upstream as well.
    set -l ahead (chezmoi git -- rev-list --count "@{u}..HEAD" 2>/dev/null)

    if test (count $dirty) -eq 0; and test "$ahead" = "0"
        echo "✓ Source tree clean and in sync with origin — nothing to send."
        return 0
    end

    if test (count $dirty) -gt 0
        echo "→ Source changes to commit:"
        chezmoi git -- status --short
        chezmoi git -- add -A
        set -l msg $argv[1]
        if test -z "$msg"
            set msg "chore(dotfiles): sync from "(hostname)
        end
        if not chezmoi git -- commit -q -m "$msg"
            echo "cz: commit failed" >&2
            return 1
        end
    else
        echo "→ No local edits; pushing "(string join ' ' $ahead)" existing commit(s)."
    end

    if not chezmoi git -- push
        echo "cz: push failed — if origin moved, run 'cz sync' to pull/rebase first" >&2
        return 1
    end
    echo "✓ Pushed."
end

function __cz_drift --description "Report local edits in ~ that are not captured in the source repo"
    set -l drift
    for line in (chezmoi status --path-style absolute 2>/dev/null)
        # First column non-blank == the file in ~ was edited after chezmoi wrote it.
        if not string match -q ' *' -- $line
            set -a drift $line
        end
    end

    if test (count $drift) -eq 0
        return 0
    end

    echo ""
    echo "✗ "(count $drift)" local edit(s) in ~ are not captured in the source repo."
    echo "  chezmoi apply would prompt for (or overwrite) them, so cz sync stopped before pulling."
    echo ""
    for line in $drift
        set -l parts (string split -m1 ' ' -- $line)
        set -l short (string replace -- "$HOME" '~' $parts[2])
        printf '  %s  %s\n' $parts[1] $short
        if string match -q '*.tmpl' -- (chezmoi source-path $parts[2] 2>/dev/null)
            printf '      keep local:   chezmoi merge %s   (template)\n' $short
        else
            printf '      keep local:   cz capture %s\n' $short
        end
        printf '      keep source:  chezmoi apply --force %s\n' $short
    end
    return 1
end

function cz --description "chezmoi shortcuts"
    switch $argv[1]
        case edit e
            # Open source file in editor, auto-applies on save
            chezmoi edit $argv[2..-1]
        case diff d
            chezmoi diff $argv[2..-1]
        case capture c
            # Import intentional target drift only when explicit targets are given.
            set -l targets $argv[2..-1]
            if test (count $targets) -eq 0
                echo "Refusing an unscoped re-add. Pass specific target files:"
                echo "  cz capture ~/.config/example/config.toml"
                echo ""
                chezmoi status
                return 1
            end

            for target in $targets
                set -l source_path (chezmoi source-path "$target")
                if string match -q '*.tmpl' -- "$source_path"
                    echo "Cannot re-add templated target: $target" >&2
                    echo "Use: chezmoi merge $target" >&2
                    return 1
                end
            end

            chezmoi diff $targets
            echo ""
            read -P "Re-add only these targets to chezmoi source? [y/N] " confirm
            if test "$confirm" = y -o "$confirm" = Y
                if chezmoi re-add $targets
                    echo "✓ Captured in source. Run 'cz sync' to send it."
                else
                    echo "cz: re-add failed — nothing captured." >&2
                    return 1
                end
            end
        case push p
            __cz_push $argv[2..-1]
        case sync s
            if test (count $argv) -gt 1
                echo "cz sync takes no arguments." >&2
                echo "  pull local edits into source:  cz capture <target>" >&2
                echo "  set a commit message:          cz push \"message\"" >&2
                return 2
            end

            # 1. send: anything changed in the source repo goes to origin first
            __cz_push
            or return 1

            # 2. refuse to receive while ~ holds edits that only exist in ~
            __cz_drift
            or return 1

            # 3. receive: pull --autostash --rebase, then apply
            echo "→ Pulling from origin"
            if not chezmoi git pull -- --autostash --rebase
                echo "✗ pull failed — resolve the conflict in the source dir (chezmoi cd), then re-run cz sync" >&2
                return 1
            end

            echo "→ Applying to ~"
            if not chezmoi apply
                echo "✗ apply failed" >&2
                return 1
            end
            echo "✓ In sync."
        case '*'
            command chezmoi $argv
    end
end

