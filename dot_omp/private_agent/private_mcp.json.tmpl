{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    }{{ if hasKey . "omp_mcp_work" }},
    "datadog": {
      "type": "http",
      "url": {{ .omp_mcp_work.datadog_url | quote }}
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientId": {{ .omp_mcp_work.figma_client_id | quote }},
        "clientSecret": {{ .omp_mcp_work.figma_client_secret | quote }}
      }
    }{{ end }}
  }
}
